# BAT60JFILM
#
DEF BAT60JFILM D 0 40 Y N 1 F N
F0 "D" 0 50 60 H V L BNN
F1 "BAT60JFILM" -50 -300 60 H V L BNN
F2 "Diodes_SMD:D_SOD-323_HandSoldering" 250 -450 60 H I C CNN
F3 "http://www.st.com/content/ccc/resource/technical/document/datasheet/3d/d2/27/1d/20/e3/4d/48/CD00001944.pdf/files/CD00001944.pdf/jcr:content/translations/en.CD00001944.pdf" -50 -700 60 H I C CNN
F4 "BAT60JFILM" -50 -550 60 H I C CNN "Part Number"
F5 "STMicroelectronics" -150 -600 60 H I C CNN "Manufacturer"
DRAW
P 2 0 1 10 100 0 100 -200 N
P 4 0 1 10 0 -200 100 -100 0 0 0 -200 F
X K 1 300 -100 200 L 50 50 0 1 P
X A 2 -200 -100 200 R 50 50 0 1 I
ENDDRAW
ENDDEF
